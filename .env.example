# ─────────────────────────────────────────────────────────────
#  Rise of Zoom — environment template
#  Copy to `.env` for local use, or paste the values into your
#  host's environment settings (Render → Environment, GitHub
#  Actions → Secrets, Docker → environment).
#  Every value below is OPTIONAL — the app ships with sane
#  defaults and boots with an empty environment.
# ─────────────────────────────────────────────────────────────

# ── Server ──────────────────────────────────────────────────
# Port the HTTP + WebSocket server listens on.
#   • Local / Docker  → 4321
#   • Render          → set by the platform, leave blank
PORT=4321

# Bind address. Must be 0.0.0.0 inside a container or the
# platform's proxy cannot reach it.
HOST=0.0.0.0

# production | development
NODE_ENV=production

# Hard cap on people allowed in a single room at once.
MAX_PARTICIPANTS=12

# ── Control-room access ─────────────────────────────────────
# Owner password  — full control, including changing the
# operator password. Override to change it in production.
ADMIN_OWNER_PASSWORD=6xtXBG78|"o_iXDZY]3a

# Operator password — day-to-day operations, cannot change
# passwords.
ADMIN_PASSWORD=Jmw£V63Gt@9aRO@9(`E,

# Secret used to sign admin session tokens.
# Generate a long random value, e.g.
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# If left blank a random secret is generated at boot, which
# invalidates existing sessions whenever the process restarts.
SESSION_SECRET=

# ── WebRTC / ICE ────────────────────────────────────────────
# STUN servers used for NAT traversal. Comma separated.
STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# TURN relays — strongly recommended once real users (not just
# localhost) join, because a TURN server is the only way to
# connect when both peers sit behind strict NAT/firewalls.
# Comma separated list of turn: URLs.
TURN_URLS=
TURN_USERNAME=
TURN_CREDENTIAL=

# ── Storage ─────────────────────────────────────────────────
# Where floor/settings/blocklist/audit state is written.
# Relative to the project root. On hosts with a read-only
# filesystem the app detects this and keeps state in memory
# instead (it logs a warning at boot).
DATA_DIR=./data

# ── Browser access ──────────────────────────────────────────
# Which origins may call this API from a browser. Leave blank to
# allow every origin — the API carries no cookies, the control-room
# token travels in an Authorization header. Set it to lock the API
# down to your own sites:
#
#   ALLOWED_ORIGINS=https://dantdante.github.io,https://rise-of-zoom.onrender.com

# ── Front-end wiring (static hosting only) ──────────────────
# The browser needs to know where the signalling server lives.
# This value is baked into `public/config.js` at build time by
# the GitHub Pages workflow, using the repository variable
# SIGNALLING_URL — you do not normally set it here.
#
#   apiBase      → base URL of the backend that serves
#                  /api/* and the Socket.IO connection
#   iceServers   → optional ICE overrides for the browser
#
# window.RISE_OF_ZOOM = {
#   apiBase: 'https://your-backend.up.railway.app',
#   iceServers: []
# }
